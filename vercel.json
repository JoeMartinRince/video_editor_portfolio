{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*).mp4",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/(.*).framercms",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/images/(.*)", "destination": "/assets/framerusercontent.com/images/$1" },
    { "source": "/sites/(.*)", "destination": "/assets/framerusercontent.com/sites/$1" },
    { "source": "/modules/(.*)", "destination": "/assets/framerusercontent.com/modules/$1" },
    { "source": "/cms/(.*)", "destination": "/assets/framerusercontent.com/cms/$1" },
    { "source": "/assets/framerusercontent.com/(.*)", "destination": "/assets/framerusercontent.com/$1" },
    { "source": "/assets/app.framerstatic.com/(.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/framerusercontent.com/assets/$1" },
    { "source": "/third-party-assets/(.*)", "destination": "/assets/framerusercontent.com/third-party-assets/$1" },
    { "source": "/(chunk-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(editorbar\\..*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(EditButton-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(render-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(dist-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(canvas-sandbox-.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(InterVariable.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(Inter-.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(prosemirror-.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(codeBlockLanguages-.*)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(google-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(fontshare-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(framer-font-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(esm-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(framer_compiler_bg-.*\\.wasm)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(serverFunctionRuntimes-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(libraryCSSRules-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(es-module-shims-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" },
    { "source": "/(castleSDKV3-.*\\.mjs)", "destination": "/assets/app.framerstatic.com/$1" }
  ]
}
